#!/usr/bin/expect

# Load helper from lib/util
source [file join $env(HOME) bin lib util load-config.tcl]

# Parse arguments
if {$argc == 0} {
    set mode "--login"
} else {
    set mode [lindex $argv 0]
}

# Display help before loading configuration or authenticating
if {$mode eq "--help" || $mode eq "-h"} {
    puts "Usage: aire \[OPTION\] \[FILES...\]"
    puts ""
    puts "Options:"
    puts "  --login               SSH login via jump host (default)"
    puts "  --copy, -scp FILES    Copy files to remote ~/dl/"
    puts "  --help, -h            Show this help message"
    puts ""
    puts "Examples:"
    puts "  aire"
    puts "  aire --login"
    puts "  aire --copy file1.py"
    puts "  aire -scp *.sh"
    puts "  aire --copy file1.py file2.py file3.sh"
    exit 0
}

# Load script's matching configuration
load_config [info script]
set timeout 60


# Build SSH or SCP command
switch -- $mode {
    "--login" {
        set command [list ssh -J \
            "${username}@${jump_host}" \
            "${username}@${destination}"]
    }

    "-scp" -
    "--copy" {
        if {$argc < 2} {
            puts stderr "Usage: aire --copy <file1> \[file2 ...\]"
            exit 1
        }

        set files [lrange $argv 1 end]

        set command [concat \
            [list scp -J "${username}@${jump_host}"] \
            $files \
            [list "${username}@${destination}:~/dl/"]]
    }

    default {
        puts stderr "Unknown option: $mode"
        puts stderr "Usage: aire --login | --copy <files...>"
        exit 1
    }
}

# Read password
send_user "Password: "
stty -echo
gets stdin password
stty echo
send_user "\n"

# Start SSH or SCP
spawn {*}$command

# Authenticate through jump host and destination
foreach domain [list $jump_host $destination] {
    set account "${username}@${domain}"

    expect {
        -ex "($account) Password:" {}
        timeout {
            puts stderr "Password prompt timed out for $domain"
            exit 1
        }
        eof {
            puts stderr "Connection closed during authentication"
            exit 1
        }
    }

    send -- "$password\r"

    expect {
        -ex "Passcode or option (1-3):" {}
        timeout {
            puts stderr "Option prompt timed out for $domain"
            exit 1
        }
        eof {
            puts stderr "Connection closed during authentication"
            exit 1
        }
    }

    send -- "1\r"
}

unset password

# Handle login or file transfer
if {$mode eq "--login"} {
    interact
} else {
    expect {
        eof {}
        timeout {
            puts stderr "SCP transfer timed out"
            exit 1
        }
    }

    catch wait result

    set exit_code [lindex $result 3]
    exit $exit_code
}
