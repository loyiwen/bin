#!/usr/bin/expect

# Load helper from lib/util
source [file join $env(HOME) bin lib util load-config.tcl]

# Load script's matching configuration
load_config [info script]

set timeout 60

# Read password
send_user "Password: "
stty -echo
gets stdin password
stty echo
send_user "\n"
	
spawn ssh -J "${username}@${jump_host}" "${username}@${destination}"

foreach domain [list $jump_host $destination] {
	set account "${username}@${domain}"

	expect {
		-ex "($account) Password:" {}
		timeout { puts stderr "Password prompt timed out for $domain"; exit 1}
		eof { puts stderr "SSH connection closed"; exit 1 }
	}

	send -- "$password\r"

	expect {
		-ex "Passcode or option (1-3):" {}
		timeout { puts stderr "Option prompt timed out for $domain"; exit 1}
		eof { puts stderr "SSH connection closed"; exit 1 }
	}

	send -- "1\r"
}

unset password

# Hand over
interact